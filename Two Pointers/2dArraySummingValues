import java.util.*;

public class 2dArraySummingValues {

    public int[][] mergeArrays(int[][] nums1, int[][] nums2) {

        List<int[]> list = new ArrayList<>();

        int i = 0;
        int j = 0;

        while(i < nums1.length && j < nums2.length){

            // Same id
            if(nums1[i][0] == nums2[j][0]){

                int id = nums1[i][0];
                int value = nums1[i][1] + nums2[j][1];

                list.add(new int[]{id, value});

                i++;
                j++;
            }

            // nums1 id smaller
            else if(nums1[i][0] < nums2[j][0]){

                list.add(new int[]{nums1[i][0], nums1[i][1]});

                i++;
            }

            // nums2 id smaller
            else{

                list.add(new int[]{nums2[j][0], nums2[j][1]});

                j++;
            }
        }

        // Remaining nums1
        while(i < nums1.length){

            list.add(new int[]{nums1[i][0], nums1[i][1]});

            i++;
        }

        // Remaining nums2
        while(j < nums2.length){

            list.add(new int[]{nums2[j][0], nums2[j][1]});

            j++;
        }

        return list.toArray(new int[list.size()][]);
    }

    public static void main(String[] args) {

        int[][] nums1 = {
            {1, 2},
            {2, 3},
            {4, 5}
        };

        int[][] nums2 = {
            {1, 4},
            {3, 2},
            {4, 1}
        };

        2dArraySummingValues obj = new 2dArraySummingValues();

        int[][] result = obj.mergeArrays(nums1, nums2);

        for(int i = 0; i < result.length; i++){

            System.out.println(
                result[i][0] + " " + result[i][1]
            );
        }
    }
}
